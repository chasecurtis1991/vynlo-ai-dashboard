# URL of the Express/SQLite backend (backend/server.js). Defaults to http://localhost:3001 if unset.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Optional: used only by scripts/notify-telegram.js (CLI helper). The dashboard itself
# stores Telegram credentials in the browser via the Settings page, not in env vars.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
